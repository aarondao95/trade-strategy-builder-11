<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Trade Strategy Builder</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #0f172a;
      color: white;
      margin: 0;
      padding: 30px;
    }

    .container {
      max-width: 720px;
      margin: auto;
      background: #111827;
      padding: 28px;
      border-radius: 20px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.4);
    }

    h1 {
      margin-bottom: 8px;
      color: #38bdf8;
    }

    p {
      color: #cbd5e1;
    }

    label {
      display: block;
      margin-top: 18px;
      font-weight: bold;
    }

    input, select, button {
      width: 100%;
      padding: 12px;
      margin-top: 8px;
      border-radius: 10px;
      border: none;
      font-size: 16px;
    }

    button {
      background: #22c55e;
      color: #052e16;
      font-weight: bold;
      cursor: pointer;
      margin-top: 24px;
    }

    .result {
      margin-top: 24px;
      background: #020617;
      padding: 20px;
      border-radius: 16px;
      line-height: 1.7;
    }

    .buy { color: #22c55e; font-weight: bold; }
    .sell { color: #ef4444; font-weight: bold; }
    .wait { color: #facc15; font-weight: bold; }

    .cta {
      display: block;
      text-align: center;
      margin-top: 24px;
      background: #2563eb;
      color: white;
      padding: 14px;
      border-radius: 12px;
      text-decoration: none;
      font-weight: bold;
    }

    .note {
      font-size: 13px;
      color: #94a3b8;
      margin-top: 20px;
    }
  </style>
</head>
<body>

  <div class="container">
    <h1>Trade Strategy Builder</h1>
    <p>Nhập tín hiệu kỹ thuật để chấm điểm cơ hội Buy/Sell và tạo chiến lược giao dịch.</p>

    <label>Khung thời gian</label>
    <select id="timeframe">
      <option>M5</option>
      <option>M15</option>
      <option>H1</option>
      <option>H4</option>
      <option>D1</option>
    </select>

    <label>RSI hiện tại</label>
    <input id="rsi" type="number" placeholder="Ví dụ: 32" />

    <label>MACD</label>
    <select id="macd">
      <option value="bullish">MACD Bullish - tín hiệu tăng</option>
      <option value="bearish">MACD Bearish - tín hiệu giảm</option>
      <option value="neutral">MACD trung tính</option>
    </select>

    <label>Giá hiện tại so với EMA 50</label>
    <select id="priceEma50">
      <option value="above">Giá nằm trên EMA 50</option>
      <option value="below">Giá nằm dưới EMA 50</option>
    </select>

    <label>EMA 50 so với EMA 200</label>
    <select id="emaTrend">
      <option value="bullish">EMA 50 nằm trên EMA 200</option>
      <option value="bearish">EMA 50 nằm dưới EMA 200</option>
    </select>

    <label>Xu hướng chính</label>
    <select id="trend">
      <option value="up">Xu hướng tăng</option>
      <option value="down">Xu hướng giảm</option>
      <option value="sideway">Sideway</option>
    </select>

    <button onclick="analyzeStrategy()">Phân tích chiến lược</button>

    <div class="result" id="result">
      Kết quả phân tích sẽ hiển thị tại đây.
    </div>

    <a class="cta" href="https://t.me/tcazglobal" target="_blank">
      Vào cộng đồng TCAZ để nhận BOT trade miễn phí
    </a>

    <div class="note">
      Lưu ý: Công cụ này chỉ hỗ trợ tham khảo chiến lược, không phải lời khuyên đầu tư.
    </div>
  </div>

  <script>
    function analyzeStrategy() {
      const timeframe = document.getElementById("timeframe").value;
      const rsi = Number(document.getElementById("rsi").value);
      const macd = document.getElementById("macd").value;
      const priceEma50 = document.getElementById("priceEma50").value;
      const emaTrend = document.getElementById("emaTrend").value;
      const trend = document.getElementById("trend").value;

      let buyScore = 0;
      let sellScore = 0;
      let notes = [];

      if (!rsi || rsi < 0 || rsi > 100) {
        document.getElementById("result").innerHTML = "Vui lòng nhập RSI từ 0 đến 100.";
        return;
      }

      if (rsi < 30) {
        buyScore += 2;
        notes.push("RSI dưới 30: thị trường có dấu hiệu quá bán.");
      } else if (rsi > 70) {
        sellScore += 2;
        notes.push("RSI trên 70: thị trường có dấu hiệu quá mua.");
      } else if (rsi >= 45 && rsi <= 55) {
        notes.push("RSI trung tính: chưa có lợi thế rõ ràng.");
      } else if (rsi > 55) {
        buyScore += 1;
        notes.push("RSI trên 55: lực mua đang nhỉnh hơn.");
      } else if (rsi < 45) {
        sellScore += 1;
        notes.push("RSI dưới 45: lực bán đang nhỉnh hơn.");
      }

      if (macd === "bullish") {
        buyScore += 2;
        notes.push("MACD bullish: ủng hộ kịch bản Buy.");
      } else if (macd === "bearish") {
        sellScore += 2;
        notes.push("MACD bearish: ủng hộ kịch bản Sell.");
      }

      if (priceEma50 === "above") {
        buyScore += 1;
        notes.push("Giá trên EMA 50: xu hướng ngắn hạn tích cực.");
      } else {
        sellScore += 1;
        notes.push("Giá dưới EMA 50: xu hướng ngắn hạn tiêu cực.");
      }

      if (emaTrend === "bullish") {
        buyScore += 2;
        notes.push("EMA 50 trên EMA 200: xu hướng trung hạn tăng.");
      } else {
        sellScore += 2;
        notes.push("EMA 50 dưới EMA 200: xu hướng trung hạn giảm.");
      }

      if (trend === "up") {
        buyScore += 2;
        notes.push("Xu hướng chính tăng: ưu tiên Buy theo trend.");
      } else if (trend === "down") {
        sellScore += 2;
        notes.push("Xu hướng chính giảm: ưu tiên Sell theo trend.");
      } else {
        notes.push("Thị trường sideway: nên giảm khối lượng hoặc chờ phá vùng.");
      }

      let decision = "";
      let strategy = "";

      if (buyScore >= sellScore + 3) {
        decision = "<span class='buy'>Ưu tiên BUY</span>";
        strategy = "Chiến lược gợi ý: Chờ giá hồi về EMA 50 hoặc vùng hỗ trợ gần nhất, tìm tín hiệu xác nhận rồi Buy. Rủi ro mỗi lệnh nên dưới 1–2% tài khoản.";
      } else if (sellScore >= buyScore + 3) {
        decision = "<span class='sell'>Ưu tiên SELL</span>";
        strategy = "Chiến lược gợi ý: Chờ giá hồi lên EMA 50 hoặc vùng kháng cự gần nhất, tìm tín hiệu xác nhận rồi Sell. Rủi ro mỗi lệnh nên dưới 1–2% tài khoản.";
      } else {
        decision = "<span class='wait'>CHỜ THÊM TÍN HIỆU</span>";
        strategy = "Chiến lược gợi ý: Tín hiệu chưa đủ lệch. Không nên vào lệnh vội. Chờ RSI/MACD/EMA đồng thuận rõ hơn.";
      }

      document.getElementById("result").innerHTML = `
        <h2>Kết quả phân tích</h2>
        <p><strong>Khung thời gian:</strong> ${timeframe}</p>
        <p><strong>Buy Score:</strong> ${buyScore}/9</p>
        <p><strong>Sell Score:</strong> ${sellScore}/9</p>
        <p><strong>Kết luận:</strong> ${decision}</p>
        <hr>
        <p><strong>Gợi ý chiến lược:</strong></p>
        <p>${strategy}</p>
        <hr>
        <p><strong>Diễn giải tín hiệu:</strong></p>
        <ul>
          ${notes.map(note => `<li>${note}</li>`).join("")}
        </ul>
      `;
    }
  </script>

</body>
</html>
